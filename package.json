{
  "name": "estatify",
  "version": "1.0.0",
  "private": true,
  "description": "Real-estate listings plugin for WordPress with custom Gutenberg blocks, a REST API and Interactivity API front end.",
  "author": "Yusuf Yuldashev",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@wordpress/interactivity": "^8.0.0",
    "@wordpress/scripts": "^37.0.0",
    "leaflet": "^1.9.4",
    "playwright": "^1.64.1"
  },
  "scripts": {
    "build": "wp-scripts build --experimental-modules --blocks-manifest",
    "start": "wp-scripts start --experimental-modules --blocks-manifest",
    "dev": "npx -y @wp-playground/cli@3.1.60 server --port=9403 --login --mount=./:/wordpress/wp-content/plugins/estatify --blueprint=./blueprint.json",
    "screenshots": "node tools/screenshots.mjs",
    "images": "node tools/generate-images.mjs",
    "lint:js": "wp-scripts lint-js src",
    "lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
    "plugin-zip": "wp-scripts plugin-zip",
    "test:smoke": "node tools/smoke-test.mjs",
    "i18n:pot": "npx -y @wp-playground/cli@3.1.60 run-blueprint --mount=./:/wordpress/wp-content/plugins/estatify --blueprint=./tools/make-pot.blueprint.json"
  },
  "files": [
    "estatify.php",
    "uninstall.php",
    "readme.txt",
    "includes",
    "build",
    "demo",
    "languages",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
